# Build outputs
build/
build/store-packages/
build-service/
out/
bin/
obj/
*.exe
*.dll
*.lib
*.pdb
*.exp
*.ilk
*.idb
ui-test/

# MSIX packaging (Store builds - generated artifacts only)
StorePackaging/Assets/*.png
!StorePackaging/Assets/.gitkeep

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Testing/
_deps/
.tools/

# Visual Studio
.vs/
*.user
*.suo
*.sln.docstates
*.vcxproj.filters
*.vcxproj.user

# CLion / Rider
.idea/
cmake-build-*/

# VS Code (keep workspace-shared settings, ignore user-local)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# Third-party dependencies fetched by CMake
third_party/juce-*/
third_party/nlohmann_json-*/
third_party/googletest-*/
third_party/*-src/
third_party/*-build/
third_party/*-subbuild/

# OS
Thumbs.db
Desktop.ini
*.tmp
*.swp

# Logs / coverage (testable-dev keeps no persistent logs but tools may emit)
*.log
coverage/
*.gcov
*.gcda
*.gcno

# Local environment / secrets (none expected; defensive)
.env
.env.*
*.pfx
*.p12
*.cer
*.crt
*.key
build-service/
_bmad/*
.specify/
third_party/juce/
third_party/nlohmann_json/
third_party/googletest/
