<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{F7D8A8F2-3C4E-4B1E-9D7A-1F6E4C8B3A9D}</ProjectGuid>
    <TargetPlatformVersion>10.0.26200.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.18363.0</TargetPlatformMinVersion>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <ProjectName>JyGlobalVST</ProjectName>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>AppPackage</ConfigurationType>
    <PlatformToolset>v145</PlatformToolset>
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <AppxBundle>Always</AppxBundle>
    <AppxPackageDir>$(SolutionDir)build\store-packages\</AppxPackageDir>
    <AppxPackageName>JyGlobalVST</AppxPackageName>
    <AppxPackageIsForStore>false</AppxPackageIsForStore>
    <GenerateTestArtifacts>true</GenerateTestArtifacts>
    <AppxUseExperimentalSigningMethod>true</AppxUseExperimentalSigningMethod>
  </PropertyGroup>

  <ItemGroup>
    <AppxManifest Include="AppxManifest.xml">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square50x50Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\Square310x310Logo.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="..\build\src\tray-app\jyglobalvst_tray_artefacts\$(Configuration)\JyGlobalVST.exe">
      <Link>JyGlobalVST.exe</Link>
    </Content>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

</Project>
